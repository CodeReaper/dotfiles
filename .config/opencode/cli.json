{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "diffs": {
    "wrap": "word"
  },
  "keybinds": {
    "agent.cycle": "tab"
  },
  "plugins": ["@slkiser/opencode-quota"],
  "session": {
    "grouping": "none",
    "permissions": "prompt",
    "scrollbar": false,
    "sidebar": "hide",
    "thinking": "show",
    "verbosity": "high"
  },
  "tabs": {
    "indicators": "status",
    "layout": "horizontal",
    "mode": "off",
    "scope": "cwd"
  },
  "terminal": {
    "copy": "select"
  },
  "theme": {
    "mode": "dark",
    "name": "tokyonight"
  }
}
