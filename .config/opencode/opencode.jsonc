// cspell:disable

{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "wanda",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "base64 *", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "break *", "effect": "allow" },
    { "action": "shell", "resource": "brew info *", "effect": "allow" },
    { "action": "shell", "resource": "brew list *", "effect": "allow" },
    { "action": "shell", "resource": "brew search *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "cd *", "effect": "allow" },
    { "action": "shell", "resource": "comm *", "effect": "allow" },
    { "action": "shell", "resource": "command *", "effect": "allow" },
    { "action": "shell", "resource": "continue *", "effect": "allow" },
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "curl *", "effect": "deny" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "date", "effect": "allow" },
    { "action": "shell", "resource": "df *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "docker *", "effect": "deny" },
    { "action": "shell", "resource": "dot *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet *", "effect": "ask" },
    { "action": "shell", "resource": "dotnet --info", "effect": "allow" },
    { "action": "shell", "resource": "dotnet --version", "effect": "allow" },
    { "action": "shell", "resource": "dotnet --list-sdks", "effect": "allow" },
    { "action": "shell", "resource": "dotnet build *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet format *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet fsi *", "effect": "deny" },
    { "action": "shell", "resource": "dotnet list *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet msbuild *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "dotnet nuget locals global-packages --list",
      "effect": "allow",
    },
    { "action": "shell", "resource": "dotnet package *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet restore *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet sln *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet test *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet clean *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet tool list *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "env", "effect": "allow" },
    { "action": "shell", "resource": "exec *", "effect": "deny" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "find * -exec *", "effect": "deny" },
    { "action": "shell", "resource": "find * -execdir *", "effect": "deny" },
    { "action": "shell", "resource": "find * -ok *", "effect": "deny" },
    { "action": "shell", "resource": "find * -okdir *", "effect": "deny" },
    { "action": "shell", "resource": "find * -delete*", "effect": "deny" },
    { "action": "shell", "resource": "gh *", "effect": "deny" },
    { "action": "shell", "resource": "git *", "effect": "ask" },
    { "action": "shell", "resource": "git add *", "effect": "deny" },
    { "action": "shell", "resource": "git apply *", "effect": "allow" },
    { "action": "shell", "resource": "git archive *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
    { "action": "shell", "resource": "git count-object *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git -C * diff *", "effect": "allow" },
    { "action": "shell", "resource": "git diff-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git for-each-ref *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git -C * log *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-remote *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "git mv *", "effect": "allow" },
    { "action": "shell", "resource": "git remote", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    {
      "action": "shell",
      "resource": "git remote get-url *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git remote show *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git show-ref *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git -C * status *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "git submodule status",
      "effect": "allow",
    },
    { "action": "shell", "resource": "go *", "effect": "allow" },
    { "action": "shell", "resource": "go run *", "effect": "ask" },
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "gzip *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "helm *", "effect": "allow" },
    { "action": "shell", "resource": "hexdump *", "effect": "allow" },
    { "action": "shell", "resource": "id *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "make *", "effect": "allow" },
    { "action": "shell", "resource": "man *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },
    { "action": "shell", "resource": "npm ci", "effect": "allow" },
    { "action": "shell", "resource": "npm run build*", "effect": "allow" },
    { "action": "shell", "resource": "npm run test*", "effect": "allow" },
    { "action": "shell", "resource": "npm view *", "effect": "allow" },
    { "action": "shell", "resource": "od *", "effect": "allow" },
    { "action": "shell", "resource": "opencode --version", "effect": "allow" },
    { "action": "shell", "resource": "opencode --help", "effect": "allow" },
    { "action": "shell", "resource": "openssl *", "effect": "allow" },
    { "action": "shell", "resource": "perl *", "effect": "deny" },
    { "action": "shell", "resource": "pip *", "effect": "deny" },
    { "action": "shell", "resource": "pip3 *", "effect": "deny" },
    { "action": "shell", "resource": "plutil -lint *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "ps *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    { "action": "shell", "resource": "python *", "effect": "deny" },
    { "action": "shell", "resource": "python3 *", "effect": "deny" },
    { "action": "shell", "resource": "read *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "allow" },
    { "action": "shell", "resource": "ruby *", "effect": "deny" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "shasum *", "effect": "allow" },
    { "action": "shell", "resource": "sleep *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "strings *", "effect": "allow" },
    { "action": "shell", "resource": "swiftlint *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "tar *", "effect": "allow" },
    { "action": "shell", "resource": "tee *", "effect": "allow" },
    { "action": "shell", "resource": "test *", "effect": "allow" },
    { "action": "shell", "resource": "textutil *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "true", "effect": "allow" },
    { "action": "shell", "resource": "uname *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "unzip *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "wget *", "effect": "deny" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "whoami", "effect": "allow" },
    { "action": "shell", "resource": "xargs *", "effect": "allow" },
    { "action": "shell", "resource": "xcodebuild *", "effect": "allow" },
    { "action": "shell", "resource": "xcrun simctl list *", "effect": "allow" },
    { "action": "shell", "resource": "xxd *", "effect": "allow" },
    { "action": "shell", "resource": "yq *", "effect": "allow" },
    { "action": "shell", "resource": "zip *", "effect": "allow" },
    { "action": "codesearch", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "todoread", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "/private/**",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "/private/tmp/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/usr/local/share/dotnet/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/skills/*/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/vendor/skills/*/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.nuget/packages/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/go/pkg/mod/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/opencode/tool-output/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/*/*/T/opencode/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/var/folders/*/*/T/opencode/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "/opt/homebrew/Cellar/go/*/libexec/src/**",
      "effect": "allow",
    },
  ],
  "skills": ["~/.agents/vendor/skills"],
  "plugins": ["@slkiser/opencode-quota"],
  "providers": {
    "openai": {},
  },
}
